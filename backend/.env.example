# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Use a dedicated database user with readWrite access to this database only.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/interview-coach

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ── AI provider ───────────────────────────────────────────────────────────────
GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=120000

# ── Frontend origin(s) ────────────────────────────────────────────────────────
# Comma-separated list. Must match the exact scheme + host + port.
CLIENT_URL=https://your-frontend.example.com

# ── Puppeteer (optional) ──────────────────────────────────────────────────────
# Set this only when the bundled Chromium path is not available (Docker/Linux).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
